# PDIS API environment.
# Copy this file to .env; never commit the populated file.
#
# Every variable the backend reads appears here, including the ones a platform
# supplies rather than a person. `tests/test_env_var_parity.py` asserts that,
# because a variable wired in code and absent from this file is one a new
# developer cannot discover and a deploy cannot be reviewed against.
#
# Commented entries are read by the code but not normally set by hand: either a
# host injects them or the default is the right answer.

# --- Model providers -------------------------------------------------------

# Required by model-backed stages.
OPENAI_API_KEY=

# Optional server-owned task tiers. Query construction, evidence summaries,
# terminal labels, and web search use the fast tier. Canonical interpretation
# and independent quantitative reviews use the reasoning tier.
OPENAI_MODEL_FAST=gpt-5.4-mini
OPENAI_MODEL_REASONING=gpt-5.4

# Required by Scout's schema-bound document-target and evidence mapping. The
# model is server-owned and not user-selectable.
ANTHROPIC_API_KEY=
ANTHROPIC_QUANTITATIVE_MODEL=claude-opus-5

# --- Retrieval sources -----------------------------------------------------

# Optional direct-source rate limit increase.
NCBI_API_KEY=

# Local ToolUniverse connection and shared bearer token. Provider credentials
# belong in .env.tooluniverse, not here.
TOOLUNIVERSE_BASE_URL=http://127.0.0.1:8080
TOOLUNIVERSE_API_TOKEN=
TOOLUNIVERSE_TIMEOUT_SECONDS=30

# Tavily web retrieval. The lane disables itself when the key is absent, so an
# environment without it behaves exactly as it did before Tavily existed.
# `advanced` depth costs two credits and `basic` one; advanced is the default
# because the reason to run this lane is the quality of the extracted page text.
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced
TAVILY_TIMEOUT_SECONDS=30
# Override only to point at a proxy or a test double.
# TAVILY_BASE_URL=

# --- Concurrency -----------------------------------------------------------

# Shared cap across all concurrently enabled retrieval adapters.
SEARCH_GLOBAL_WORKER_LIMIT=48

# How many analyses run at once before the rest queue. This is sized against the
# instance's memory ceiling, not against throughput: see the deployment jobspec,
# where the two are set together. Raising one without the other either wastes
# memory or exceeds the allocation.
MAX_CONCURRENT_RUNS=2

# --- Browser origins -------------------------------------------------------

# Comma-separated full origins. Only needed when the client and this gateway are
# served from different origins: a single-hostname deployment routes /api/* to
# the gateway, which makes every browser call same-origin and leaves this unset.
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Logging ---------------------------------------------------------------

# JSON by default, because the destination is an aggregator reading allocation
# stdout. `text` is easier to read locally.
LOG_LEVEL=INFO
LOG_FORMAT=text
