# PDIS API environment.
# Copy this file to .env; never commit the populated file.

# Required by model-backed stages.
OPENAI_API_KEY=

# Optional server-owned task tiers. Query construction, evidence summaries,
# terminal labels, and web search use the fast tier. Canonical interpretation
# and quantitative semantic mapping use the reasoning tier.
OPENAI_MODEL_FAST=gpt-5.4-mini
OPENAI_MODEL_REASONING=gpt-5.4

# Optional but recommended for provider-diverse Scout target verification.
# Without this key, the review board remains available but every proposal is
# flagged for manual review. The model is server-owned and not user-selectable.
ANTHROPIC_API_KEY=
ANTHROPIC_REVIEW_MODEL=claude-opus-5

# Optional direct-source rate limit increase.
NCBI_API_KEY=

# Local ToolUniverse connection and shared bearer token. Provider credentials
# belong in .env.tooluniverse, not here.
TOOLUNIVERSE_BASE_URL=http://127.0.0.1:8080
TOOLUNIVERSE_API_TOKEN=
TOOLUNIVERSE_TIMEOUT_SECONDS=30

# Render injects TOOLUNIVERSE_HOST and TOOLUNIVERSE_PORT from its private
# service automatically. Local development should use BASE_URL above instead.

# Shared cap across all concurrently enabled retrieval adapters.
SEARCH_GLOBAL_WORKER_LIMIT=48
