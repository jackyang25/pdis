# PDIS API environment. Generated from shared/settings.py by
# scripts/generate_env_example.py; edit that table, not this file.
# Copy this file to .env; never commit the populated file.
#
# Uncommented entries are what you set: credentials, and the values a local run
# differs on. Commented entries are optional overrides; unset, the default shown
# applies, so a default changed in code reaches every environment.

# --- Model gateway -----------------------------------------------------------

# Kong's gateway key. When set, both the OpenAI-compatible and the native Anthropic
# clients route through Kong's unified endpoints with this one key, and
# OPENAI_API_KEY / ANTHROPIC_API_KEY are not used. Issued by the foundation's AI
# gateway team.
KONG_KEY=

# Direct OpenAI key, used only when KONG_KEY is unset.
# OPENAI_API_KEY=

# Direct Anthropic key, used only when KONG_KEY is unset.
# ANTHROPIC_API_KEY=

# --- Retrieval ---------------------------------------------------------------
# Searcher calls every provider directly. A key raises that provider's quota, so set
# all of them: each lane runs without its key, more slowly, except Semantic Scholar
# and Tavily, which report themselves unconfigured until theirs is set.

# NCBI E-utilities (PubMed): ~10 calls a second with a key, ~3 without. Issued from
# an NCBI account's settings: https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=

# Semantic Scholar: one call a second with a key. Keyless calls share a public pool
# that is rate-limited in practice, so the lane needs this key. The limit is the
# key's, across everything using it: give each environment its own.
# https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=

# openFDA (FDA Regulatory and FDA Safety): 120,000 calls a day with a key, 1,000
# without. https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# Tavily web search, a paid service: the lane disables itself without a key. Use a
# production key; a development key allows 100 requests a minute.
# https://app.tavily.com
TAVILY_API_KEY=

# A contact providers may write to about this deployment's traffic: sent as NCBI's
# `email` and in the User-Agent. A team mailbox, never a person's. Unset sends none.
# SEARCH_CONTACT_EMAIL=

# --- Concurrency -------------------------------------------------------------

# Analyses that run at once before the rest queue. Sized against the instance's
# memory, not throughput: the deployment jobspec states the two together.
# Default: 2
# MAX_CONCURRENT_RUNS=

# --- Employee MCP access (optional) ------------------------------------------
# Off unless configured; its settings and setup are in api/mcp/README.md.

# --- Logs --------------------------------------------------------------------

# `json` for a deployment's log aggregator; `text` is easier to read locally.
# Default: json
LOG_FORMAT=text

# Python logging level.
# Default: INFO
# LOG_LEVEL=
