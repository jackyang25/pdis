# python
__pycache__/
*.py[cod]
*$py.class

# virtual environments
.venv/
venv/
env/

# packaging/build outputs
build/
dist/
*.egg-info/

# test, lint, and coverage artifacts
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# node / next
web/node_modules/
web/.next/
web/tsconfig.tsbuildinfo

# environment and secrets
.env
.env.*
!.env.example
!.env.tooluniverse.example
# Browser-exposed, and the only one of the three that holds no secret. It was
# caught by `.env.*` above and so never tracked, which left `make dev` and the
# README telling a fresh clone to copy a file it does not have.
!web/.env.local.example

# editor and os files
.DS_Store
.vscode/
.idea/

# local agent settings and scratch work
/.claude/settings.local.json
/.superpowers/

# Generated from shared/prompt_reference.json by web/scripts/copy-shared.mjs
web/public/prompt-reference.json
