# Browser-exposed local configuration. Never put secrets in this file.
# Copy this file to web/.env.local.
#
# These are inlined by Next.js at build time, not read at runtime. A value set
# on a running container is ignored, because the browser bundle was already
# written; that is why a deployment serving the client and the API from one
# hostname sets neither and lets requests go out relative (same-origin).
#
# Local development is the case that needs a value, because the client is on
# :3000 and the API on :8000 and a relative call cannot reach across.
NEXT_PUBLIC_PDIS_API_URL=http://localhost:8000

# Bare hostname alternative, assumed https. Only for a split-origin deployment
# where the API has its own hostname; prefer the full URL above everywhere else.
# NEXT_PUBLIC_PDIS_API_HOST=
