# Turn the `engines` declaration in package.json into an error rather than a
# warning. The web tests run TypeScript directly with `--experimental-strip-types`,
# which needs Node 22.6; on an older runtime npm would warn, `npm ci` would
# succeed, and the failure would arrive later as `node: bad option`, naming the
# flag rather than the cause. This is what `requires-python` does for the backend.
engine-strict=true
